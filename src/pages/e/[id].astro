---
// /e/[id] — permanent, shareable page for a single incident.
// One page is generated per incident_id in public/incidents.json at build time;
// incidents added to the JSON get their page automatically on the next build.
// URLs are keyed on incident_id ONLY (never the title), so links survive renames.
import { readFileSync } from "node:fs";
import path from "node:path";

export async function getStaticPaths() {
  const file = path.resolve("./public/incidents.json");
  const data = JSON.parse(readFileSync(file, "utf-8"));
  const rows = [...(data.lm || []), ...(data.non_lm || [])];

  const seen = new Set();
  const paths = [];
  for (const r of rows) {
    const id = (r.incident_id || "").trim();
    if (!id) {
      throw new Error(
        `incidents.json: row missing incident_id (task: "${r.task || "?"}"). ` +
        `Every incident must carry a stable incident_id for its permalink.`
      );
    }
    if (seen.has(id)) {
      throw new Error(`incidents.json: duplicate incident_id "${id}". Ids must be unique.`);
    }
    seen.add(id);
    paths.push({ params: { id }, props: { task: r.task || "", category: r.category || "" } });
  }
  return paths;
}

const { id } = Astro.params;
const { task, category } = Astro.props;
const pageTitle = `${id} — ${task || "incident"} · CHEATSHEET`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <meta name="description" content={`${category} incident ${id}: ${task}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/app/tokens.css" />
    <style>
      html, body { margin: 0; padding: 0; background: white; min-height: 100%; }
      body { font-family: "Plain", ui-sans-serif, system-ui, sans-serif; }
      #root { min-height: 100vh; }
    </style>

    <script is:inline src="https://unpkg.com/react@18.3.1/umd/react.development.js" integrity="sha384-hD6/rw4ppMLGNu3tX5cjIb+uRZ7UkRJ6BPkLpg4hAu/6onKUg4lLsHAs9EBPT82L" crossorigin="anonymous"></script>
    <script is:inline src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.development.js" integrity="sha384-u6aeetuaXnQ38mYT8rp6sbXaQe3NL9t+IBXmnYxwkUI2Hw4bsp2Wvmx4yRQF1uAm" crossorigin="anonymous"></script>
    <script is:inline src="https://unpkg.com/@babel/standalone@7.29.0/babel.min.js" integrity="sha384-m08KidiNqLdpJqLq95G/LEi8Qvjl/xUYll3QILypMoQ65QorJ9Lvtp2RXYGBFj1y" crossorigin="anonymous"></script>

    <script is:inline type="text/babel" src="/app/shared.jsx"></script>
    <script is:inline type="text/babel" src="/app/v6-tree.jsx"></script>
    <script is:inline type="text/babel" src="/app/incident-page.jsx"></script>
  </head>
  <body>
    <div id="root"></div>

    <script define:vars={{ pageIncidentId: id }}>
      window.__INCIDENT_ID__ = pageIncidentId;
    </script>

    <script is:inline type="text/babel" data-presets="env,react">
      ReactDOM.createRoot(document.getElementById("root")).render(
        <IncidentPage id={window.__INCIDENT_ID__} />
      );
    </script>
  </body>
</html>
