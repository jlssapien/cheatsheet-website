---
import "../assets/reset.css";
interface Props { title: string; }
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/app/tokens.css" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  .prose-body {
    max-width: 780px;
    margin: 0 auto;
    padding: 3rem 2rem 6rem;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    line-height: 1.8;
    color: var(--color-text);
  }
  .prose-body h1 { font-size:1.0rem; font-weight:700; margin:0 0 0.5rem; }
  .prose-body h2 { font-size:1.0rem; font-weight:700; margin:2.5rem 0 0.75rem; padding-top:2rem; border-top:2px solid var(--color-accent); }
  .prose-body h2:first-of-type { border-top:none; padding-top:0; }
  .prose-body h3 { font-size:0.92rem; font-weight:700; margin:1.75rem 0 0.5rem; }
  .prose-body p { margin-bottom:1rem; }
  .prose-body ul, .prose-body ol { margin:0.75rem 0 1rem 1.5rem; }
  .prose-body li { margin-bottom:0.3rem; }
  .prose-body a { color:var(--color-accent); text-decoration:underline; text-underline-offset:2px; }
  .prose-body a:hover { background:var(--color-accent-light); }
  .prose-body strong { font-weight:700; }
  .prose-body em { font-style:italic; }
  .prose-body code { font-family:var(--font-mono); background:var(--nord6); padding:0.05rem 0.3rem; border-radius:3px; }
  .prose-body pre { background:var(--nord6); padding:0.75rem; border-radius:4px; overflow-x:auto; }
  .prose-body hr { border:none; border-top:1px solid var(--nord4); margin:2rem 0; }
</style>
